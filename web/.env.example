# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined at build time, so set them before `next build`.

# Public URL of the site. Used for metadata, sitemap and robots. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the backend API. Leave empty until the backend exists.
NEXT_PUBLIC_API_URL=

# Shows one-click sample accounts on /login. Set to false once real auth exists.
NEXT_PUBLIC_SHOW_SAMPLE_ACCOUNTS=true
