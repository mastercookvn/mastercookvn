# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined at build time, so set them before `next build`.

# Public URL of the site. Used for metadata, sitemap and robots. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the backend API. Leave empty until the backend exists.
NEXT_PUBLIC_API_URL=

# Shows one-click sample accounts on /login. Set to false once real auth exists.
NEXT_PUBLIC_SHOW_SAMPLE_ACCOUNTS=true

# Media bucket. Records store object keys such as dishes/goi.jpg, never URLs.
# /api/media/<key> redirects to a short-lived presigned URL. Leave empty to serve
# the local copy in public/images/ (git-ignored) during development.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Temporary STS session token, when the credentials above are temporary.
MEDIA_S3_SESSION_TOKEN=
# S3-compatible endpoint such as MinIO (http://localhost:9000). Empty for AWS.
MEDIA_S3_ENDPOINT=
